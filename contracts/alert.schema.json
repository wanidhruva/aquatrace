{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aquatrace.local/contracts/alert.schema.json",
  "title": "AquaTrace Alert",
  "description": "Backend -> dashboard alert record with evidence payload",
  "type": "object",
  "required": [
    "alert_id",
    "camera_id",
    "severity",
    "state",
    "started_at",
    "updated_at",
    "transitions",
    "reasoning",
    "status"
  ],
  "properties": {
    "alert_id": { "type": "string" },
    "camera_id": { "type": "string" },
    "severity": { "type": "string", "enum": ["watch", "escalating", "critical"] },
    "state": { "type": "string", "enum": ["normal", "watch", "escalating", "verifying", "critical"] },
    "started_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "closed_at": { "type": ["string", "null"], "format": "date-time" },
    "status": { "type": "string", "enum": ["active", "acknowledged", "false_positive", "resolved"] },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "at", "reason"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "at": { "type": "string", "format": "date-time" },
          "reason": { "type": "string" }
        }
      }
    },
    "evidence_snapshot_url": { "type": ["string", "null"] },
    "telemetry_window": {
      "type": "array",
      "description": "Ring of telemetry points captured around the event",
      "items": { "type": "object" }
    },
    "reasoning": { "type": "string" },
    "corroboration": {
      "type": ["object", "null"],
      "properties": {
        "verified": { "type": "boolean" },
        "method": { "type": "string", "enum": ["adjacent_cameras", "high_rate_sampling", "timeout_persistence", "high_confidence"] },
        "confidence": { "type": "number" },
        "cameras": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "camera_id": { "type": "string" },
              "delta_pct": { "type": "number" },
              "state": { "type": "string" }
            }
          }
        },
        "note": { "type": "string" }
      }
    },
    "agent_confidence": { "type": "number" },
    "acknowledged_at": { "type": ["string", "null"] },
    "false_positive": { "type": "boolean", "default": false }
  }
}
